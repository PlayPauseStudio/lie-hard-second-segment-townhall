# Copy to .env.local for dev. On Vercel, add these as Project → Environment Variables.
# Same Firebase project as the main show (lie-hard-live). The apiKey is a public id.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Operator sign-in account (Firebase email/password). Must match the email in
# web/firestore.rules → isSeg2Operator().
NEXT_PUBLIC_SEG2_OPERATOR_EMAIL=segment2-operator@playgroundcomedy.studio
